# GeoGuess environment variables.
# Copy to `.env` and fill in values. The `.env` file is gitignored.

# ── Webapp ───────────────────────────────────────────────────────────────────
# Required only if you want to use the /api/export endpoint to pull human guess
# data as JSON. If unset (or empty), the export endpoint returns 403.
GEOGUESS_EXPORT_KEY=

# ── Notebook (train / evaluate modes) ────────────────────────────────────────
# Required to pull OSV-5M shards from HuggingFace. Create a read-only token at
# https://huggingface.co/settings/tokens
HF_TOKEN=
